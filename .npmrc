# pnpm settings
auto-install-peers=true
strict-peer-dependencies=false

# Registry components live outside apps/www; hoist their deps to the workspace
# root so they resolve (typecheck + bundling) from registry/agentive-ui/.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=lucide-react
public-hoist-pattern[]=@radix-ui/*
public-hoist-pattern[]=class-variance-authority
public-hoist-pattern[]=clsx
public-hoist-pattern[]=tailwind-merge
public-hoist-pattern[]=react-markdown
public-hoist-pattern[]=remark-gfm
public-hoist-pattern[]=shiki

# Local Verdaccio dev registry (see CONTRIBUTING.md). Scoped to localhost only.
# NOTE: dummy, non-secret credential for the local throwaway registry only.
# The base64 value decodes to agentive:password123.
//localhost:4873/:_auth=YWdlbnRpdmU6cGFzc3dvcmQxMjM=
